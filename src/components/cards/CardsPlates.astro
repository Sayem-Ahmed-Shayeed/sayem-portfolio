---
// Papers and datasets as two-up plates: a large framed figure with the text set beneath it.
// Each figure is uncovered left to right as it scrolls into view (the right-hand plate a beat later).
import { Image } from 'astro:assets';
import { isSelf, list, teamLabel, type Entry } from '../../data/cards';
interface Props { entries: Entry[] }
const { entries } = Astro.props;
const meta = (e: Entry) =>
  e.kind === 'paper' ? e.venue
  : e.kind === 'dataset' ? [e.venue, String(e.year), e.size].filter(Boolean).join(', ')
  : [String(e.year), e.status, teamLabel(e.team)].filter(Boolean).join(', ');
---
<ul class="plates">
  {entries.map((e, i) => (
    <li class="plate" id={e.anchor} style={`--col:${i % 2}`}>
      <a class="fig" href={e.image?.src} target="_blank" rel="noreferrer" aria-label={`Open the full image for ${e.title}`}>
        {e.image && <Image src={e.image} alt={e.alt} widths={[400, 800, 1200]} sizes="(max-width: 820px) 100vw, 440px" loading="lazy" decoding="async" />}
      </a>
      <p class="meta">{meta(e)}</p>
      <h3>{e.title}</h3>
      {e.people.length > 0 && <p class="people">{e.people.map((n, i) => <><span class:list={{ self: isSelf(n) }}>{n}</span>{i < e.people.length - 1 && ', '}</>)}</p>}
      <p class="summary">{e.summary}</p>
      {e.stack.length > 0 && <p class="detail">Built with {list(e.stack)}.</p>}
      <p class="links">{e.links.map(l => <a href={l.url} target="_blank" rel="noreferrer">{l.label}</a>)}</p>
    </li>
  ))}
</ul>

<script>
  import { toneFrames } from '../../scripts/frame-tone';
  toneFrames();
  if (matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window) {
    document.querySelectorAll<HTMLElement>('.plates .plate').forEach(plate => {
      plate.classList.add('is-armed');
      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { plate.classList.add('is-shown'); io.disconnect(); } }, { threshold: 0.3 });
      io.observe(plate);
    });
  }
</script>

<style>
  .plates { margin:0; padding:0; list-style:none; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:48px 36px; }
  .plate { display:flex; flex-direction:column; min-width:0; }
  .fig { display:grid; place-items:center; aspect-ratio:16 / 10; margin-bottom:16px; padding:14px; border:0.5px solid color-mix(in srgb,var(--ink) 75%,transparent); border-radius:12px; background:var(--fig-bg, var(--paper-2)); overflow:hidden; transition:border-color .3s ease, background-color .4s ease, filter .3s ease; }
  .fig img { width:100%; height:100%; object-fit:contain; border-radius:6px; transition:transform .5s cubic-bezier(.2,.7,.2,1); }
  .plate:hover .fig { border-color:var(--gold); }
  /* the frame takes the image's own edge colour (set by frame-tone); light images are dimmed a little in dark mode */
  :global(html[data-theme='dark']) .fig:not(.is-dark-image) { filter:brightness(.9); }
  .plate:hover .fig img { transform:scale(1.04); }
  .meta { margin:0 0 6px; font:500 13px/1.4 var(--sans); color:var(--muted); }
  h3 { margin:0; font:400 18px/1.38 var(--serif); color:var(--ink); text-wrap:pretty; }
  .people { margin:8px 0 0; font:400 13px/1.55 var(--sans); color:var(--ink-2); }
  .self { font-weight:600; color:var(--ink); }
  .summary { margin:10px 0 0; font:400 14.5px/1.65 var(--sans); color:var(--ink-2); }
  .detail { margin:6px 0 0; font:400 13px/1.55 var(--sans); color:var(--muted); }
  /* links sit on a rule at the bottom, so they line up across a row */
  .plate > :nth-last-child(2) { margin-bottom:16px; }
  .links { display:flex; flex-wrap:wrap; gap:6px 18px; margin:auto 0 0; padding-top:12px; border-top:1px solid var(--line); }
  .links a { font:500 13.5px/1.4 var(--sans); color:var(--ink); text-decoration:underline; text-decoration-color:color-mix(in srgb,var(--gold) 70%,transparent); text-underline-offset:4px; }
  .links a:hover { text-decoration-color:var(--gold); text-decoration-thickness:2px; }
  .is-armed .fig { clip-path:inset(0 100% 0 0 round 12px); }
  .is-shown .fig { animation:uncover .8s cubic-bezier(.65,0,.35,1) calc(var(--col) * 140ms) forwards; }
  @keyframes uncover { to { clip-path:inset(0 0 0 0 round 12px); } }
  @media (max-width:820px) { .plates { grid-template-columns:1fr; gap:40px; } .plate { --col:0; } }
  @media (max-width:560px) { h3 { font-size:18px; } }
</style>

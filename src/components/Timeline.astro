---
const { items } = Astro.props;
---
<div class="timeline">
  {items.map((item, i) => (
    <article class="timeline-item reveal" style={`--delay:${i * 50}ms`}>
      <div class="timeline-marker" aria-hidden="true"></div>
      <div class="timeline-date mono">{item.date}</div>
      <div class="timeline-content">
        <div class="meta-row"><span class="badge">{item.badge}</span></div>
        <h3>{item.title}</h3>
        <p class="timeline-org">{item.org}</p>
        {item.text && <p>{item.text}</p>}
        {item.link && <a class="text-link" href={item.link} target="_blank" rel="noreferrer">View source ↗</a>}
      </div>
    </article>
  ))}
</div>

---
// Achievements as a two-by-two set of cards; a certificate sits beside its text in the same thin rounded frame
// as the paper and project figures. Each card rises in as it scrolls into view (the right-hand one a beat later)
// and its certificate is uncovered left to right.
import { Image } from 'astro:assets';
import type { Achievement } from './shared';
interface Props { items: Achievement[] }
const { items } = Astro.props;
---
<ul class="achieve-cards">
  {items.map((a, i) => (
    <li class:list={['card', { 'has-fig': a.image }]} style={`--col:${i % 2}`}>
      {a.image && (
        <a class="fig" href={a.image.src} target="_blank" rel="noreferrer" aria-label={`Open the ${a.title} certificate`}>
          <Image src={a.image} alt={`${a.title} certificate`} widths={[320, 640, 960]} sizes="(max-width: 640px) 100vw, 150px" loading="lazy" />
        </a>
      )}
      <div class="text">
        <p class="when">{a.year}</p>
        <h3>{a.title}</h3>
        <p class="detail">{a.detail}</p>
        {a.link && <p class="links"><a href={a.link} target="_blank" rel="noreferrer">Verify</a></p>}
      </div>
    </li>
  ))}
</ul>

<script>
  import { toneFrames } from '../../scripts/frame-tone';
  toneFrames();
  if (matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window) {
    document.querySelectorAll<HTMLElement>('.achieve-cards .card').forEach(card => {
      card.classList.add('is-armed');
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        card.classList.add('is-shown');
        // hand the card back to its resting styles once the entrance is over
        setTimeout(() => card.classList.remove('is-armed', 'is-shown'), 1600);
      }, { threshold: 0.35 });
      io.observe(card);
    });
  }
</script>

<style>
  .achieve-cards { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; margin:0; padding:0; list-style:none; }
  .card { display:grid; align-content:start; gap:18px; min-width:0; padding:22px 24px; border:1px solid var(--line); border-radius:12px; background:var(--paper-2); transition:border-color .3s ease; }
  .card.has-fig { grid-template-columns:150px minmax(0,1fr); gap:20px; }
  .card:hover { border-color:color-mix(in srgb,var(--gold) 65%,var(--line)); }
  .text { min-width:0; }
  .when { margin:0 0 6px; font:500 12.5px/1.4 var(--sans); color:var(--muted); }
  h3 { margin:0; font:400 17.5px/1.38 var(--serif); color:var(--ink); text-wrap:pretty; }
  .detail { margin:8px 0 0; font:400 14.5px/1.62 var(--sans); color:var(--ink-2); }
  .links { margin:12px 0 0; }
  .links a { font:500 13.5px/1.4 var(--sans); color:var(--ink); text-decoration:underline; text-decoration-color:color-mix(in srgb,var(--gold) 70%,transparent); text-decoration-thickness:1px; text-underline-offset:4px; }
  .links a:hover { text-decoration-color:var(--gold); text-decoration-thickness:2px; }
  .fig { display:grid; place-items:center; aspect-ratio:4 / 3; padding:8px; border:0.5px solid color-mix(in srgb,var(--ink) 75%,transparent); border-radius:10px; background:var(--fig-bg, var(--paper-2)); overflow:hidden; transition:border-color .3s ease, background-color .4s ease; }
  .fig img { width:100%; height:100%; object-fit:contain; border-radius:4px; transition:transform .5s cubic-bezier(.2,.7,.2,1); }
  .card:hover .fig { border-color:var(--gold); }
  .card:hover .fig img { transform:scale(1.03); }
  :global(html[data-theme='dark']) .fig:not(.is-dark-image) { filter:brightness(.9); }

  /* entrance: the card rises in, then its certificate is uncovered left to right */
  .is-armed { opacity:0; transform:translateY(14px); }
  .is-armed .fig { clip-path:inset(0 100% 0 0 round 10px); }
  .is-shown { animation:card-in .6s cubic-bezier(.2,.7,.2,1) calc(var(--col) * 130ms) forwards; }
  .is-shown .fig { animation:uncover .8s cubic-bezier(.65,0,.35,1) calc(var(--col) * 130ms + 260ms) forwards; }
  @keyframes card-in { to { opacity:1; transform:none; } }
  @keyframes uncover { to { clip-path:inset(0 0 0 0 round 10px); } }

  @media (max-width:640px) {
    .achieve-cards { grid-template-columns:1fr; }
    .card.has-fig { grid-template-columns:1fr; }
    .fig { max-width:360px; }
    .card { --col:0; }
  }
</style>

---
const { project } = Astro.props;
const d = project.data;
---
<article class:list={['project-card','reveal', d.featured && 'featured-card']}>
  <div class="project-thumb">
    {d.image ? <img src={d.image} alt={d.alt || `${d.title} preview`} loading="lazy" decoding="async" /> : <div class="thumb-placeholder"></div>}
  </div>
  <div class="project-body">
    <div class="meta-row">
      <span class="mono">{d.date.getFullYear()}</span>
      {d.status && <span class="badge gold">{d.status}</span>}
      {d.team && <span class:list={['badge', d.team.toLowerCase() === 'solo' ? 'team-solo' : 'team-group']}>{d.team.toLowerCase() === 'solo' ? 'Solo' : 'Group'}</span>}
    </div>
    <h3>{d.title}</h3>
    <p>{d.description}</p>
    {d.role && <p class="role-line"><strong>Role:</strong> {d.role}</p>}
    <div class="link-row capsule card-actions">{d.links.map((link) => <a href={link.url} target="_blank" rel="noreferrer" aria-label={`${link.label} for ${d.title}`}>{link.label}<span aria-hidden="true">↗</span></a>)}</div>
  </div>
</article>
